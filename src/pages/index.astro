---
import BaseLayout from '../layouts/BaseLayout.astro';

const stack = ['BigQuery', 'dbt', 'Redash', 'SQL', 'Python'];
---

<BaseLayout title="Home">
  <section class="hero">
    <p class="eyebrow">Data Analyst · Flip ID</p>
    <h1>Aubert Oktaviantono</h1>
    <p class="lede">
      I turn messy data into decisions — building reliable pipelines and
      dashboards with BigQuery, dbt, and Redash. Currently leveling up
      toward analytics engineering and looking for the next challenge.
    </p>
    <ul class="stack">
      {stack.map((item) => <li>{item}</li>)}
    </ul>
    <div class="cta">
      <a class="button primary" href="/resume/">View résumé</a>
      <a class="button" href="/projects/">See projects</a>
      <a class="button ghost" href="https://github.com/aubertoktav" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="button ghost" href="mailto:aubert.oktaviantono@flip.id">Email</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 6rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .eyebrow {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    margin: 0;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }
  .lede {
    color: var(--text-dim);
    max-width: 42rem;
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0.5rem 0;
    list-style: none;
  }
  .stack li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .button {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.6rem 1.1rem;
    color: var(--text);
  }
  .button:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #06231f;
    font-weight: 600;
  }
  .button.ghost {
    color: var(--text-dim);
  }
</style>
